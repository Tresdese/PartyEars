# Copia este archivo a .env y pon las contraseñas de los roles <servicio>_svc.
# .env no se sube a git. Las contraseñas se piden al administrador del servidor, nunca por chat.

# IP por la que llegas al servidor: LAN (192.168.1.75), WireGuard (10.8.0.1) u OpenVPN (10.9.0.1).
DB_HOST=192.168.1.75

# Cada servicio tiene su propio contenedor PostgreSQL, en su propio puerto.
AUTH_DB_PORT=5441
MUSIC_DB_PORT=5442
PARTY_DB_PORT=5443
QUEUE_DB_PORT=5444
STREAMING_DB_PORT=5445
LOGS_DB_PORT=5446

AUTH_DB_PASSWORD=
MUSIC_DB_PASSWORD=
PARTY_DB_PASSWORD=
QUEUE_DB_PASSWORD=
STREAMING_DB_PASSWORD=
LOGS_DB_PASSWORD=
