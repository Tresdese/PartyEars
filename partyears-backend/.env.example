# Copia este archivo a .env (no se sube a git). Las contraseñas nunca van por chat.

# IP por la que llegas al servidor: LAN (192.168.1.75), WireGuard (10.8.0.1) u OpenVPN (10.9.0.1).
DB_HOST=192.168.1.75

AUTH_DB_PORT=5441
MUSIC_DB_PORT=5442
PARTY_DB_PORT=5443
QUEUE_DB_PORT=5444
STREAMING_DB_PORT=5445
LOGS_DB_PORT=5446

# Desarrollo: tu cuenta personal de PostgreSQL, sirve para los 6 servicios.
# Si DB_USER tiene valor, se ignoran las contraseñas *_svc de abajo.
DB_USER=
DB_PASSWORD=

# Servidor (despliegue): deja DB_USER vacío y usa los roles <servicio>_svc.
AUTH_DB_PASSWORD=
MUSIC_DB_PASSWORD=
PARTY_DB_PASSWORD=
QUEUE_DB_PASSWORD=
STREAMING_DB_PASSWORD=
LOGS_DB_PASSWORD=
